; Runs every MakerPrint E3NG macro through Klipper in batch mode (no printer needed).
STATUS
HELP
G28
GET_POSITION
QUERY_ENDSTOPS
QUERY_PROBE
; a whole print, as the slicer sends it
EXCLUDE_OBJECT_DEFINE NAME=cube_1 CENTER=110,110 POLYGON=[[100,100],[120,100],[120,120],[100,120]]
EXCLUDE_OBJECT_DEFINE NAME=cube_2 CENTER=150,150 POLYGON=[[140,140],[160,140],[160,160],[140,160]]
START_PRINT BED=60 EXTRUDER=215 MATERIAL=PETG
EXCLUDE_OBJECT_START NAME=cube_1
G1 X105 Y105 Z0.2 F6000
G1 X115 Y105 E0.5 F3000
G2 X115 Y115 I0 J5 E0.5
G10
G11
EXCLUDE_OBJECT_END NAME=cube_1
EXCLUDE_OBJECT NAME=cube_2
M117 Layer 2 of 50
M900 K0.05
M486 S1
M486 S-1
M220 S150
M221 S95
SET_GCODE_OFFSET Z_ADJUST=0.02 MOVE=1
PAUSE
PAUSE
M104 S0
RESUME
M600
PURGE_MORE
LOAD_FILAMENT TEMP=220
RESUME
RESUME
END_PRINT
; cancel path
START_PRINT BED=55 EXTRUDER=205
G1 X50 Y50 Z0.3 E1 F3000
CANCEL_PRINT
; purge with no labelled objects
EXCLUDE_OBJECT RESET=1
START_PRINT
END_PRINT
; filament and moving around
M109 S215
LOAD_FILAMENT
UNLOAD_FILAMENT
UNLOAD_FILAMENT TEMP=230
PARK
CENTER
CLEAN_NOZZLE
G29
PRINT_MODE MODE=quiet
PRINT_MODE MODE=fast
PRINT_MODE MODE=normal
PRINT_MODE MODE=bogus
; calibration
CALIBRATION_WIZARD
_PROMPT_CLOSE
Z_CHECK
PROBE_CHECK
PROBE_Z_OFFSET
TESTZ Z=-0.1
_PAPER_DONE ACTION=ACCEPT
PROBE_Z_OFFSET BED=70 EXTRUDER=160
_PAPER_DONE ACTION=ABORT
BED_SCREWS
MESH_FULL
BED_MESH_PROFILE LOAD=default
EXTRUDER_CALIBRATE
EXTRUDER_RESULT LEFT=22.5
SET_INPUT_SHAPER
RINGING_TOWER
PA_CALIBRATE
SPEED_TEST ITERATIONS=2
SPEED_TEST SPEED=200 ACCEL=4000 ITERATIONS=1 BOUND=40
AXIS_TWIST_COMPENSATION_CALIBRATE
ABORT
; last: the direction test resets the position, so it goes at the end
DIRECTION_TEST
DIRECTION_TEST STEP=1
DIRECTION_TEST STEP=2
DIRECTION_TEST STEP=3
DIRECTION_TEST STEP=9
M84
