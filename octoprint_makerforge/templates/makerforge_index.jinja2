<!doctype html>
{#- The whole app is one static page. It must contain nothing user specific: OctoPrint caches it. -#}
<html lang="en" data-theme="forge" data-density="comfortable">
<head>
  <meta charset="utf-8">
  <title>MakerPrint</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#17181b">
  <meta name="robots" content="noindex, nofollow">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="MakerPrint">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  {%- set sb = boot.staticBase %}
  <link rel="manifest" href="{{ boot.pluginBase }}/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ sb }}/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ sb }}/img/favicon-16.png">
  <link rel="icon" type="image/png" sizes="96x96" href="{{ sb }}/img/favicon-96.png">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ sb }}/img/apple-touch-icon.png">

  <link rel="preload" href="{{ sb }}/fonts/IBMPlexSans-var.woff2" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="{{ sb }}/css/tokens.css?v={{ asset_v }}">
  <link rel="stylesheet" href="{{ sb }}/css/base.css?v={{ asset_v }}">
  <link rel="stylesheet" href="{{ sb }}/css/components.css?v={{ asset_v }}">
  <link rel="stylesheet" href="{{ sb }}/css/shell.css?v={{ asset_v }}">
  <link rel="stylesheet" href="{{ sb }}/css/views.css?v={{ asset_v }}">
  <link rel="stylesheet" href="{{ sb }}/css/studio.css?v={{ asset_v }}">
  <script>
    // The look saved in this browser, set before anything is drawn so a light page never flashes dark.
    try {
      if ((JSON.parse(localStorage.getItem("mf.prefs.v1") || "{}") || {}).look === "studio") {
        document.documentElement.setAttribute("data-look", "studio");
        document.querySelector('meta[name="color-scheme"]').content = "light";
        document.querySelector('meta[name="theme-color"]').content = "#ffffff";
      }
    } catch (e) { /* storage blocked: the default look */ }
  </script>

  <script type="application/json" id="mf-boot">{{ boot|tojson }}</script>
  <script type="importmap">{{ import_map|tojson }}</script>
</head>
<body>
  <div id="boot" class="boot" role="status" aria-live="polite">
    <img class="boot-mark" src="{{ sb }}/img/icon-192.png" alt="" width="64" height="64">
    <p class="boot-text">Starting MakerPrint&hellip;</p>
    <p class="boot-fail" hidden>
      This browser is too old for the MakerPrint UI.
      <a href="{{ boot.classicUrl }}">Open the classic OctoPrint UI</a>
    </p>
  </div>
  <div id="app" hidden></div>
  <div id="overlays"></div>

  <noscript>
    <p class="boot-fail" style="display:block">
      MakerPrint needs JavaScript. <a href="{{ boot.classicUrl }}">Open the classic OctoPrint UI</a>
    </p>
  </noscript>

  <script>
    // Browsers without import map support cannot run the app; tell people how to get out.
    (function () {
      var ok = window.HTMLScriptElement && HTMLScriptElement.supports && HTMLScriptElement.supports("importmap");
      if (!ok) {
        var f = document.querySelector("#boot .boot-fail"), t = document.querySelector("#boot .boot-text");
        if (f) f.hidden = false;
        if (t) t.hidden = true;
      }
    })();
  </script>
  <script type="module" src="{{ sb }}/js/app.js?v={{ asset_v }}"></script>
</body>
</html>
