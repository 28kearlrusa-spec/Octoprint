# Klipper "make menuconfig" choices for the Creality v4.2.2 board (Ender 3 V2).
# Build with:  make KCONFIG_CONFIG=<this file> olddefconfig && make KCONFIG_CONFIG=<this file>
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL_BAUD=250000
